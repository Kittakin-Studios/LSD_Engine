<rml>
<head>
<style>
body { font-family: sans; width: 100%; height: 100%; }
div { display: block; }
#hud { position: absolute; left: 30px; top: 30px; color: #FFE51A; font-size: 30px; white-space: nowrap;
       background-color: rgba(0, 0, 0, 140); padding: 6px 14px; border-radius: 6px; }
#msg { position: absolute; left: 0; right: 0; top: 40%; text-align: center; color: #FFFFFF; font-size: 48px; }
</style>
</head>
<body><div id="hud">Coins 0 / 8</div><div id="msg"></div></body>
</rml>
