<rml>
<head>
<title>Character Selection</title>
<style>
body { font-family: sans; width: 100%; height: 100%; color: #FFFFFF; }
div { display: block; }
#bar { position: absolute; left: 50%; bottom: 40px; width: 720px; margin-left: -360px; padding: 16px 20px; text-align: center;
       background-color: rgba(13, 4, 4, 215); border: 2px #F3C312; border-radius: 10px; }
#title { position: absolute; left: 0; right: 0; top: 30px; text-align: center; font-size: 40px; font-weight: bold; color: #FFE51A; }
#preset_name { display: inline-block; width: 420px; font-size: 32px; font-weight: bold; }
#preset_count { font-size: 18px; color: #BBBBBB; margin: 6px 0 10px 0; }
.arrow { display: inline-block; width: 60px; padding: 6px 0; font-size: 30px; background-color: #025291; border-radius: 6px;
         nav: auto; tab-index: auto; focus: auto; }
.arrow:hover, .arrow:focus { background-color: #EEA70E; }
.button { display: inline-block; padding: 8px 40px; background-color: #F3C312; color: #141414; font-size: 24px; font-weight: bold;
          border-radius: 6px; nav: auto; tab-index: auto; focus: auto; }
.button:hover, .button:focus { background-color: #FFE51A; }
#status { color: #9BE11F; font-size: 18px; margin-top: 8px; }
</style>
</head>
<body>
<div id="title">Choose your character</div>
<div id="bar">
<button class="arrow" id="prev" onclick="prev_preset">&lt;</button><span id="preset_name">-</span><button class="arrow" id="next" onclick="next_preset">&gt;</button>
<div id="preset_count"></div>
<button class="button" id="select" onclick="select_preset">Select</button>
<div id="status"></div>
</div>
</body>
</rml>
